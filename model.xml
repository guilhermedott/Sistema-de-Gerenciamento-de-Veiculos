<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<featureModel>
	<properties>
		<graphics key="autolayoutconstraints" value="false"/>
		<graphics key="legendautolayout" value="true"/>
		<graphics key="showconstraints" value="true"/>
		<graphics key="showshortnames" value="false"/>
		<graphics key="layout" value="horizontal"/>
		<graphics key="showcollapsedconstraints" value="true"/>
		<graphics key="legendhidden" value="false"/>
		<graphics key="layoutalgorithm" value="1"/>
	</properties>
	<struct>
		<and abstract="true" mandatory="true" name="SistemadeGerenciamentodeVeiculos">
			<or abstract="true" name="Cadastro">
				<feature name="Pessoas"/>
				<feature name="Carros"/>
				<feature name="Mecanicas"/>
				<feature name="Seguradoras"/>
				<feature name="Concessionarias"/>
				<feature name="Produtos"/>
			</or>
			<and abstract="true" name="Validação">
				<feature name="CPF"/>
				<feature name="CNPJ"/>
				<feature name="Chassis"/>
				<feature name="Numero de Série"/>
			</and>
			<or abstract="true" name="Relatório">
				<feature name="Seguros"/>
				<feature name="Danos"/>
				<feature name="Donos"/>
				<feature name="Manutenções"/>
				<feature name="Info. Gerais"/>
			</or>
			<or abstract="true" name="Lembretes">
				<feature name="Troca de Componentes"/>
				<feature name="Revisões"/>
				<feature name="Prazos"/>
				<feature name="Andamento de Processos"/>
			</or>
		</and>
	</struct>
	<constraints>
		<rule>
			<imp>
				<var>CPF</var>
				<conj>
					<var>Pessoas</var>
					<var>Carros</var>
				</conj>
			</imp>
		</rule>
		<rule>
			<imp>
				<var>CNPJ</var>
				<disj>
					<var>Carros</var>
					<disj>
						<var>Concessionarias</var>
						<disj>
							<var>Mecanicas</var>
							<disj>
								<var>Produtos</var>
								<var>Seguradoras</var>
							</disj>
						</disj>
					</disj>
				</disj>
			</imp>
		</rule>
	</constraints>
</featureModel>
